              ]
            },
            "description": "`Bearer alice` is not a token: rejected.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"seats\": [\n    \"A9\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
