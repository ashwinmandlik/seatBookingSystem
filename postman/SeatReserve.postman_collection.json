      ]
    },
    {
      "name": "4. Hold -> confirm, cancel",
      "item": [
        {
          "name": "Bob holds A3 (201 held)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{bobToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/shows/{{showId}}/reserve",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "shows",
                "{{showId}}",
                "reserve"
              ]
            },
            "description": "`hold: true` reserves the seat until `expires_at` (HOLD_TTL_SECONDS, default 300 s). If it isn't confirmed by then, the sweeper releases it.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"seats\": [\n    \"A3\"\n  ],\n  \"hold\": true,\n  \"idempotency_key\": \"{{$guid}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"bobHoldId\", pm.response.json().reservation_id);",
                  "pm.test(\"held with a deadline\", () => { const r = pm.response.json(); pm.expect(r.status).to.eql(\"held\"); pm.expect(r.expires_at).to.be.a(\"string\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Bob's reservation",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{bobToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/reservations/{{bobHoldId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "reservations",
                "{{bobHoldId}}"
              ]
            },
            "description": "Owner only."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Alice reads Bob's reservation (404)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{aliceToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/reservations/{{bobHoldId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "reservations",
                "{{bobHoldId}}"
              ]
            },
            "description": "Someone else's reservation is reported as not found, so ids cannot be probed."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 404\", () => pm.response.to.have.status(404));",
                  "pm.test(\"error code RESERVATION_NOT_FOUND\", () => pm.expect(pm.response.json().error.code).to.eql(\"RESERVATION_NOT_FOUND\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Bob confirms the hold",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{bobToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/reservations/{{bobHoldId}}/confirm",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "reservations",
                "{{bobHoldId}}",
                "confirm"
              ]
            },
            "description": "Turns the hold into a sale. Idempotent: confirming twice returns the same reservation."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"confirmed\", () => pm.expect(pm.response.json().status).to.eql(\"confirmed\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Alice cancels her reservation",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{aliceToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/reservations/{{aliceReservationId}}/cancel",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "reservations",
                "{{aliceReservationId}}",
                "cancel"
              ]
            },
            "description": "Seat A1 goes back to available and Alice's quota is returned. Idempotent."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"cancelled\", () => pm.expect(pm.response.json().status).to.eql(\"cancelled\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Show counts after all of the above",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/shows/{{showId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "shows",
                "{{showId}}"
              ]
            },
            "description": "Expected: A3 and A8 confirmed (Bob), everything else available."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "const c = pm.response.json().counts;",
                  "pm.test(\"2 confirmed, 0 held, 8 available\", () => pm.expect([c.confirmed, c.held, c.available]).to.eql([2, 0, 8]));",
                  "pm.test(\"invariant holds\", () => pm.expect(c.available + c.held + c.confirmed).to.eql(c.total));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
